  <!-- Moon -->
  <div id="cosmic-moon"></div>
  <!-- Planets — JS fades these in after page load -->
  <div id="planet-1"></div>
  <div id="planet-2"></div>
  <div id="planet-3"></div>
  <div id="planet-4"></div>
</div>

