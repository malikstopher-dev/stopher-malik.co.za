<!-- ═══════════════════════════════ ABOUT ═══════════════════════════════ -->
<section class="section" id="about">
  <div class="section-inner">
    <div class="about-grid">

      <div class="reveal">
        <div class="about-media">
          <!-- Personal brand portrait card with real photo -->
          <div class="about-portrait-card">
            <div class="portrait-frame">
              <div class="portrait-avatar" aria-label="Stopher Malik — SMK Web Design">
                <picture><source srcset="assets/stopher-portrait.webp" type="image/webp"/><img
                  src="assets/stopher-portrait.png" fetchpriority="high"
                  alt="Stopher Malik — founder of SMK Web Design, web developer based in Johannesburg"
                  class="portrait-photo"
                  width="180" height="180"
                  loading="eager"
                  decoding="async"
                /></picture>
                <div class="portrait-ring"></div>
                <div class="portrait-glow"></div>
              </div>
              <div class="portrait-status">
                <span class="status-dot"></span>
                <span>Available for projects</span>
              </div>
            </div>
            <div class="portrait-tags">
              <span class="p-tag">⚡ Web Developer</span>
              <span class="p-tag">🎯 Conversion Expert</span>
              <span class="p-tag">📍 Johannesburg, ZA</span>
            </div>
          </div>
          <div class="about-float-badge">
            <div class="badge-num" data-count="6" data-suffix="+">6+</div>
            <div class="badge-label">Projects<br/>Delivered</div>
          </div>
        </div>
      </div>

      <div class="reveal reveal-delay-2">
        <div class="label">About Me</div>
        <h2 class="about-name">Stopher Malik</h2>
        <div class="about-role">Web Designer &amp; Developer — Johannesburg, South Africa</div>

        <p class="about-bio">I'm a web designer and developer based in Johannesburg, focused on helping South African businesses turn their websites into client-generating machines. I don't just build websites — I design <strong>systems that attract, engage, and convert</strong> visitors into paying customers.</p>
        <p class="about-bio" style="margin-top:0.8rem">Every web design project I take on is built with performance, speed, and real business results in mind. My goal is simple: <em>help businesses across South Africa grow online with websites that actually make money — not just look good.</em></p>

        <div class="about-stats">
          <div class="about-stat">
            <div class="stat-n" data-count="6" data-suffix="+">6+</div>
            <div class="stat-l">Projects</div>
          </div>
          <div class="about-stat">
            <div class="stat-n" data-count="100" data-suffix="%">100%</div>
            <div class="stat-l">Satisfaction</div>
          </div>
          <div class="about-stat">
            <div class="stat-n" data-count="48" data-suffix="h">48h</div>
            <div class="stat-l">First Draft</div>
          </div>
        </div>

        <div class="pills">
          <span class="pill">React</span><span class="pill">Next.js</span><span class="pill">Node.js</span>
          <span class="pill">TypeScript</span><span class="pill">PostgreSQL</span><span class="pill">MongoDB</span>
          <span class="pill">AWS</span><span class="pill">Cloudflare</span><span class="pill">SEO</span>
          <span class="pill">UI/UX</span><span class="pill">Branding</span>
        </div>

        <button class="btn btn-primary" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
          Work With Me →
        </button>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════ SERVICES ═══════════════════════════════ -->
<section class="section" id="services" style="background:var(--ink2)">
  <div class="section-inner">
    <div class="reveal" style="text-align:center;max-width:600px;margin:0 auto 0">
      <div class="label" style="justify-content:center">What I Offer</div>
      <h2 class="display-heading"><span class="accent">SERVICES</span> BUILT<br/><span class="outline">FOR RESULTS</span></h2>
      <p class="section-intro" style="margin:0 auto">Professional web design services for South African businesses — built around one goal: getting you more clients online.</p>
    </div>

    <div class="services-grid">

      <div class="svc-card reveal reveal-delay-1">
        <div class="svc-icon">🎨</div>
        <div class="svc-num">01_</div>
        <h3 class="svc-title">Website Design</h3>
        <p class="svc-desc">Professional website design for Johannesburg businesses — fast, mobile-first, and built to turn visitors into paying customers.</p>
        <button class="svc-expand-btn" aria-expanded="false">
          <span class="expand-label">Details</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="svc-panel">
          <div class="svc-panel-inner">
            <ul>
              <li>Landing pages designed to convert</li>
              <li>Multi-page business websites</li>
              <li>Mobile-first responsive layouts</li>
              <li>Brand-consistent UI systems</li>
              <li>Performance-optimised delivery</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="svc-card reveal reveal-delay-2">
        <div class="svc-icon">⚡</div>
        <div class="svc-num">02_</div>
        <h3 class="svc-title">Full-Stack Development</h3>
        <p class="svc-desc">React, Next.js and Node.js applications built with clean architecture, ready for scale from day one.</p>
        <button class="svc-expand-btn" aria-expanded="false">
          <span class="expand-label">Details</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="svc-panel">
          <div class="svc-panel-inner">
            <ul>
              <li>React / Next.js frontends</li>
              <li>Node.js / Express APIs</li>
              <li>Database design (PostgreSQL, MongoDB)</li>
              <li>Authentication &amp; user management</li>
              <li>Third-party integrations</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="svc-card reveal reveal-delay-3">
        <div class="svc-icon">📈</div>
        <div class="svc-num">03_</div>
        <h3 class="svc-title">SEO &amp; Performance</h3>
        <p class="svc-desc">Technical SEO and speed optimisation that moves your website up Google in South Africa and keeps your visitors engaged.</p>
        <button class="svc-expand-btn" aria-expanded="false">
          <span class="expand-label">Details</span>
