          <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
            <input type="hidden" name="access_key" value="23d51a8d-11fc-48a5-bae3-02ca670202c3"/>
            <input type="hidden" name="subject" value="New enquiry from SMK Web Design — stopher-malik.co.za"/>
            <input type="hidden" name="from_name" value="SMK Web Design Website"/>
            <input type="hidden" name="redirect" value="false"/>
            <!-- Honeypot: bots fill this, humans don't see it -->
            <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" aria-hidden="true"/>
            <!-- Extra honeypot text field — positioned off-screen -->
            <input type="text" name="website_url" style="position:absolute;left:-9999px;top:-9999px;opacity:0;height:0;width:0;" tabindex="-1" autocomplete="off" aria-hidden="true"/>

            <div class="form-row">
              <div class="f-group">
                <label class="f-label" for="f-name">Name *</label>
                <input class="f-input" id="f-name" name="name" type="text" placeholder="John Smith" required autocomplete="name"/>
              </div>
              <div class="f-group">
                <label class="f-label" for="f-email">Email *</label>
                <input class="f-input" id="f-email" name="email" type="email" placeholder="john@example.com" required autocomplete="email"/>
              </div>
            </div>

            <div class="f-group">
              <label class="f-label" for="f-phone">Phone (optional)</label>
              <input class="f-input" id="f-phone" name="phone" type="tel" placeholder="+27 __ ___ ____" autocomplete="tel"/>
            </div>

            <div class="f-group">
              <label class="f-label" for="f-service">Service</label>
              <select class="f-select" id="f-service" name="service">
                <option value="">Select a service…</option>
                <option>Website Design</option>
                <option>Full-Stack Development</option>
                <option>E-Commerce Store</option>
                <option>SEO &amp; Performance</option>
                <option>Branding &amp; Logo</option>
                <option>Startup Package</option>
                <option>Other / Not Sure</option>
              </select>
            </div>

            <div class="f-group">
              <label class="f-label" for="f-msg">Message *</label>
              <textarea class="f-textarea" id="f-msg" name="message" placeholder="Tell me about your project — what do you need and when?" required></textarea>
            </div>

            <button class="form-submit" id="form-btn" type="submit">
              <span class="spinner" aria-hidden="true"></span>
              <span class="btn-label">Send Message</span>
            </button>

            <div id="form-status" class="form-status-msg" role="alert" aria-live="polite"></div>
          </form>
        </div>
      </div>

