    <div class="trust-item"><span class="check">✓</span> Designed to Convert</div>
    <div class="trust-item"><span class="check">✓</span> Trusted by Growing Businesses</div>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</header>

